# Copy this file to .env and fill in your key.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-key-here

# Accounts the social specialist should watch (comma-separated).
# Leave a list empty to skip that platform.

# Bluesky handles, e.g. blocktrainer.bsky.social
BLUESKY_ACCOUNTS=

# Nostr public keys (npub1... or hex). This is where most Bitcoiners post.
NOSTR_ACCOUNTS=

# Mastodon accounts as user@instance.social
MASTODON_ACCOUNTS=

# X/Twitter is currently NOT used - no reliable free access (see README).
X_ACCOUNTS=
